{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reward-profile.schema.json",
  "title": "PolyQuest reward-profile resource",
  "description": "A named, non-empty list of rewards. Store under data/<namespace>/reward_profiles/**/*.json.",
  "type": "object",
  "required": ["rewards"],
  "properties": {
    "rewards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "polyquest.schema.json#/$defs/reward" }
    }
  },
  "additionalProperties": false
}
